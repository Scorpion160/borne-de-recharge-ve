# auto = tente VE-SCOPE Hub puis revient aux données simulées si le Hub est indisponible
# simulation = force le mode simulation
VITE_VESCOPE_DATA_SOURCE=auto

# Laisser vide pour utiliser automatiquement ws://<hôte>:8003/api/v1/ws/devices/<device>
# VITE_VESCOPE_HUB_WS=ws://localhost:8003/api/v1/ws/devices/borne-01

VITE_VESCOPE_DEVICE_ID=borne-01
